# Copy to .env and replace this value with: openssl rand -base64 48
JWT_SIGNING_KEY=

# Existing music directory; mounted read-only by the app container.
MEDIA_PATH=./media

# Local ports; the native-development commands in README.md use these defaults.
POSTGRES_PORT=55432
REDIS_PORT=56379
HTTP_PORT=8080

# App container user; set to the uid/gid that can read your music.
PUID=1000
PGID=1000

# Optional OIDC login. Leave disabled to retain password-only behavior.
LOCAL_LOGIN_ENABLED=true
OIDC_ENABLED=false
OIDC_DISPLAY_NAME=Single sign-on
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Browser-facing origin, with no path or trailing slash, e.g. https://cosine.example.com
OIDC_PUBLIC_ORIGIN=
# With this disabled, existing users must link their identity from Profile first.
OIDC_AUTO_PROVISION_USERS=false
# false is for a local development identity provider only.
OIDC_REQUIRE_HTTPS_METADATA=true
