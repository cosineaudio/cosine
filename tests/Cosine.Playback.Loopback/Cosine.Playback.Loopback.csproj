<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A fake device for tests: simulated clock, no I/O, no audio device.
    Referenced ONLY by Cosine.Tests and registered through the test host's DI. It is not
    in the shipped application and has no configuration switch, so there is no production
    code path that exists only to be turned off.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cosine.Playback.Abstractions\Cosine.Playback.Abstractions.csproj" />
  </ItemGroup>

</Project>
