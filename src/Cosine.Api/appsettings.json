{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "cosine": "Host=localhost;Database=cosine;Username=cosine;Password=cosine",
    "redis": "localhost:6379"
  },
